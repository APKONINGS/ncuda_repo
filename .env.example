# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Portal authentication ─────────────────────────────────────────────
# "demo" (default): fictional accounts + in-memory data, for demonstrations.
# "supabase": reserved for the Supabase-backed portal (next milestone).
NCUDA_AUTH_MODE=demo

# Signs session cookies in demo mode. REQUIRED in production (32+ chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── Contact form ──────────────────────────────────────────────────────
# Messages are POSTed as JSON to this URL (email service, Edge Function, …).
# Leave empty and the form tells visitors honestly that it is not yet active.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# ── Supabase ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Demo mode only. "clean" starts with just the President General (to test with
# real people); "stakeholders" starts from the prepared stakeholder demo
# (lib/demo/stakeholder-seed.json); leave unset for the fictional sample organisation.
NCUDA_DEMO_SEED=
# Demo mode only. Save demo data to this file so it survives restarts
# (delete the file to start over). Leave unset to keep data in memory only.
NCUDA_DEMO_STORE_FILE=

# Demo mode, hosted (e.g. Vercel): keep the demo data in an online store
# (Upstash Redis) shared by every copy of the site. Vercel's Upstash integration
# sets KV_REST_API_URL / KV_REST_API_TOKEN, which are read too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: name of the store key (default "ncuda-demo").
NCUDA_STORE_KEY=
