/**
 * Generates supabase/migrations/…_seed_roles.sql from the TypeScript
 * permission catalogue and default role configuration, so the database and
 * the application can never disagree about what a role means.
 *
 *   npm run db:seed-roles
 */
import { writeFileSync } from "node:fs";
import { PERMISSIONS } from "../lib/permissions/catalog.ts";
import { ROLES } from "../lib/permissions/roles.ts";

const q = (s: string) => `'${s.replace(/'/g, "''")}'`;
const out: string[] = [
  "-- GENERATED by scripts/generate-seed.mts — do not edit by hand.",
  "-- Default configuration; NCUDA may change role permissions later through an admin process.",
  "",
  "insert into public.organizations (name) select 'NCUDA' where not exists (select 1 from public.organizations);",
  "",
  "insert into public.permissions (key, label, grp) values",
  Object.entries(PERMISSIONS)
    .map(([key, p]) => `  (${q(key)}, ${q(p.label)}, ${q(p.group)})`)
    .join(",\n") + "\non conflict (key) do update set label = excluded.label, grp = excluded.grp;",
  "",
  "insert into public.roles (key, name, description, scope_level, rank) values",
  ROLES.map((r) => `  (${q(r.key)}, ${q(r.name)}, ${q(r.description)}, ${q(r.scopeLevel)}, ${r.rank})`).join(",\n") +
    "\non conflict (key) do update set name = excluded.name, description = excluded.description, scope_level = excluded.scope_level, rank = excluded.rank;",
  "",
  "insert into public.role_permissions (role_key, permission_key) values",
  ROLES.flatMap((r) => r.permissions.map((p) => `  (${q(r.key)}, ${q(p)})`)).join(",\n") + "\non conflict do nothing;",
  "",
  "insert into public.role_assignable_roles (role_key, assignable_role_key) values",
  ROLES.flatMap((r) => r.assignableRoles.map((a) => `  (${q(r.key)}, ${q(a)})`)).join(",\n") + "\non conflict do nothing;",
  "",
];

writeFileSync(new URL("../supabase/migrations/20261004000004_seed_roles.sql", import.meta.url), out.join("\n"));
console.log("Wrote supabase/migrations/20261004000004_seed_roles.sql");
